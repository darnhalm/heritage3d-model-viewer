{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports" : true,
        "baseUrl": ".",
        "esModuleInterop" : true,
        "inlineSources": true,
        "jsx": "react",
        "lib": [
            "es2019",
            "dom",
            "dom.iterable",
        ],
        // es2022 so the lazily imported SPZ codec (dynamic import) type-checks
        "module": "es2022",
        "moduleResolution": "node",
        "noEmit": true,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "target": "es2022"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "**/*.js", "dist", "src_backup", "static_backup"]
}
